<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.horizontal-tiler"
          path="/org/gnome/shell/extensions/horizontal-tiler/">

    <!-- Keybinding to toggle tiling on/off for the current workspace -->
    <key name="toggle-tiling" type="as">
      <default>['&lt;Super&gt;&lt;Shift&gt;t']</default>
      <summary>Toggle tiling on/off</summary>
      <description>Keyboard shortcut to enable or disable automatic tiling for the current workspace.</description>
    </key>

    <!-- Keybinding to move window to the left -->
    <key name="move-left" type="as">
      <default>['&lt;Super&gt;comma']</default>
      <summary>Move window to the left</summary>
      <description>Keyboard shortcut to move the window to the left.</description>
    </key>

    <!-- Keybinding to move window to the right -->
    <key name="move-right" type="as">
      <default>['&lt;Super&gt;period']</default>
      <summary>Move window to the right</summary>
      <description>Keyboard shortcut to move the window to the right.</description>
    </key>

    <!-- Keybinding to swap the displayed window with the window to the left -->
    <key name="swap-left" type="as">
      <default>['&lt;Super&gt;&lt;Shift&gt;comma']</default>
      <summary>Swap window with left neighbor</summary>
      <description>Keyboard shortcut to swap the displayed window with the window to its left.</description>
    </key>

    <!-- Keybinding to swap the displayed window with the window to the right -->
    <key name="swap-right" type="as">
      <default>['&lt;Super&gt;&lt;Shift&gt;period']</default>
      <summary>Swap window with right neighbor</summary>
      <description>Keyboard shortcut to swap the displayed window with the window to its right.</description>
    </key>

  </schema>
</schemalist>
